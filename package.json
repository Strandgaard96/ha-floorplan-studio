{
  "name": "ha-floorplan-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draw your home inside Home Assistant and use it as a live dashboard.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "shots": "FP_TEST_BUILD=1 node scripts/build.mjs && node scripts/shots.mjs",
    "demo-gif": "node scripts/build.mjs && node scripts/demo-gif.mjs",
    "dev": "vite --config vite.config.ts --mode editor --host 127.0.0.1 src/editor",
    "docs:schema": "node scripts/gen-schema-docs.mjs > docs/schema.md",
    "docs:check": "markdown-link-check docs/*.md README.md CONTRIBUTING.md",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.2",
    "markdown-link-check": "^3.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
